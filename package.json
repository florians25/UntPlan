{
  "name": "untplan",
  "productName": "UntPlan",
  "version": "0.1.0",
  "description": "UntPlan – Stundenplan- und Vertretungsplanung für Schulen in Nordrhein-Westfalen",
  "author": "UntPlan",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "portal": "node server/portal-server.mjs"
  },
  "build": {
    "appId": "de.untplan.desktop",
    "productName": "UntPlan",
    "copyright": "UntPlan",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "untplan",
        "name": "UntPlan Schuldatei",
        "description": "UntPlan Schuldatei",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "UntPlan-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "UntPlan",
      "artifactName": "UntPlan-Setup-${version}.${ext}",
      "installerLanguages": [
        "de_DE"
      ]
    },
    "portable": {
      "artifactName": "UntPlan-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.5",
    "cross-env": "7.0.3",
    "electron": "38.8.6",
    "electron-builder": "26.15.3",
    "immer": "10.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "wait-on": "8.0.5"
  },
  "dependencies": {}
}
