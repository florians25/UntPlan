# UntPlanWeb (wie web/Caddyfile)
{$UNTPLANWEB_DOMAIN} {
	encode gzip
	reverse_proxy untplanweb:8080
	header Strict-Transport-Security "max-age=31536000"
}

# UntPlan Studio (Beta)
{$STUDIO_DOMAIN} {
	encode zstd gzip
	reverse_proxy untplanstudio:8080 {
		flush_interval -1
	}
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 64MB
	}
}
