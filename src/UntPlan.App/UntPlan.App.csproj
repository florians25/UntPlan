<Project Sdk="Microsoft.NET.Sdk">
  <!-- Klassische Windows-Desktopanwendung (Windows Forms). Die FrameworkReference erlaubt
       zusätzlich das Kompilieren auf Linux/macOS (CI, Tests); ausgeführt wird unter Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>UntPlan.App</RootNamespace>
    <AssemblyName>UntPlan</AssemblyName>
    <ApplicationIcon>..\..\build\untplan.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>UntPlan – Stunden- und Vertretungsplanung</AssemblyTitle>
    <DefineConstants>$(DefineConstants);UNTPLANDESKTOP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ProjectReference Include="..\UntPlan.Core\UntPlan.Core.csproj" />
    <!-- Krypton Suite (BSD-3-Clause, offizielle NuGet-Pakete; Lizenz siehe Lizenzen/Krypton.txt): Andockleisten für Werkzeugfenster -->
    <PackageReference Include="Krypton.Toolkit" Version="105.26.7.201" />
    <PackageReference Include="Krypton.Ribbon" Version="105.26.7.201" />
    <PackageReference Include="Krypton.Navigator" Version="105.26.7.201" />
    <PackageReference Include="Krypton.Workspace" Version="105.26.7.201" />
    <PackageReference Include="Krypton.Docking" Version="105.26.7.201" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
    <!-- dieselbe Update-Prüfung wie UntPlanWeb/UntPlanMobile (GitHub-Releases) -->
    <Compile Include="..\..\web\src\UntPlanWeb\Dienste\Updatepruefung.cs" Link="Update\Updatepruefung.cs" />
    <!-- Programmsymbole: FatCow „Farm-Fresh Web Icons“ (CC BY 3.0, siehe Bilder/FatCow/LIZENZ.txt) – ausschließlich, keine gezeichneten Symbole -->
    <EmbeddedResource Include="Bilder\FatCow\16\*.png" LogicalName="FatCow.16.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Bilder\FatCow\32\*.png" LogicalName="FatCow.32.%(Filename)%(Extension)" />
    <!-- offizielle graue Varianten desselben Satzes (Ordner 16x16-grey und 32x32-grey) für deaktivierte Knöpfe -->
    <EmbeddedResource Include="Bilder\FatCow\16g\*.png" LogicalName="FatCow.16g.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Bilder\FatCow\32g\*.png" LogicalName="FatCow.32g.%(Filename)%(Extension)" />
    <!-- Programmlogo (kein Programmsymbol; erzeugt von build/logo.py) -->
    <EmbeddedResource Include="..\..\build\untplan-logo-256.png" LogicalName="Logo.untplan-logo-256.png" />
    <!-- Fenstersymbol aller Fenster und Dialoge: dasselbe Logo wie das Programmsymbol (16 bis 256 px) -->
    <EmbeddedResource Include="..\..\build\untplan.ico" LogicalName="Logo.untplan.ico" />
    <None Include="Bilder\FatCow\LIZENZ.txt" CopyToOutputDirectory="PreserveNewest" Link="Lizenzen\FatCow-Symbole.txt" />
    <None Include="Lizenzen\Krypton.txt" CopyToOutputDirectory="PreserveNewest" Link="Lizenzen\Krypton.txt" />
  </ItemGroup>
</Project>
